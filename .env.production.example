# Copie para .env.production e ajuste (NUNCA versione o arquivo real).
# Gere segredos fortes, ex.: openssl rand -hex 32

POSTGRES_USER=erp
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=erp

# Chave JWT — ao menos 32 bytes aleatórios
JWT_SECRET=troque-por-uma-chave-aleatoria-de-32-bytes-ou-mais

# Origens permitidas (CORS). Como o Nginx serve tudo na mesma origem,
# basta o IP público da VM. JSON list.
CORS_ORIGINS=["http://SEU-IP-PUBLICO"]

# --- HTTPS (opcional) — só ao usar docker-compose.https.yml (Caddy) ---
# Domínio apontando (registro A) para o IP da VM:
DOMAIN=seudominio.com.br
# Ao migrar p/ HTTPS, troque o CORS para o domínio https:
#   CORS_ORIGINS=["https://seudominio.com.br"]
